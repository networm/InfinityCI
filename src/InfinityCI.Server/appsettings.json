{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "data/logs/server-.log",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ]
  },
  "InfinityCI": {
    "DataDir": "data",
    "MaxConcurrentBuilds": 2
  },
  "AllowedHosts": "*"
}
