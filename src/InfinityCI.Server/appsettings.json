{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "data/logs/server-.log",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ]
  },
  "InfinityCI": {
    "DataDir": "data",
    "MaxConcurrentJobs": 2,
    "Ldap": {
      "Enabled": false,
      "Server": "",
      "Port": 389,
      "BaseDn": "dc=example,dc=org",
      "BindDn": "",
      "BindPassword": "",
      "UserSearchFilter": "(uid={0})",
      "DisplayNameAttribute": "displayName",
      "UseSsl": false,
      "AcceptAnyCertificate": false
    }
  },
  "AllowedHosts": "*"
}
